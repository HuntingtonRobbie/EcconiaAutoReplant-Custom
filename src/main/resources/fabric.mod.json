{
	"schemaVersion": 1,
	"id": "ecconia-auto-replant",
	"version": "${version}",
	"name": "Ecconia's Auto Replanter",
	"description": "Harvests and replants crops on interaction. Supports every vanilla crop (including cocoa, torchflowers and pitcher plants), with settings in Mod Menu.",
	"authors": [
		"Ecconia"
	],
	"contact": {
		"sources": "https://github.com/Ecconia/EcconiaAutoReplant",
		"issues": "https://github.com/Ecconia/EcconiaAutoReplant/issues"
	},
	"license": "GPLv3",
	"icon": "assets/ecconia-auto-replant/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.ecconia.fabric.autoreplant.AutoReplant"
		],
		"modmenu": [
			"de.ecconia.fabric.autoreplant.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "ecconia-auto-replant.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	},
	"accessWidener": "ecconia-auto-replant.client.accesswidener"
}
